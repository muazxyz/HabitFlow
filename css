[data-theme=sunset]{--bg:#120a07;--panel:#1d1210;--panel2:#281914;--bd:#3b2619;--tx:#fbeee3;--mu:#b9967f;--a1:#f97316;--a2:#fbbf24;--soft:#5a2a0e;--dg:#ff4d5e;--h0:#2a1b14;--h1:#5c2a10;--h2:#c2570c;--h3:#f97316;--g1:rgba(249,115,22,.26);--g2:rgba(251,191,36,.14);--hv:1.4;--ov:rgba(10,4,2,.6)}
[data-theme=custom]{--panel2:color-mix(in srgb,var(--panel) 88%,var(--tx));--bd:color-mix(in srgb,var(--panel) 80%,var(--tx));--mu:color-mix(in srgb,var(--tx) 58%,var(--bg));--soft:color-mix(in srgb,var(--a1) 28%,var(--bg));--dg:#ff4d5e;--h0:color-mix(in srgb,var(--bg) 85%,var(--tx));--h1:color-mix(in srgb,var(--a1) 30%,var(--bg));--h2:color-mix(in srgb,var(--a1) 62%,var(--bg));--h3:var(--a1);--g1:color-mix(in srgb,var(--a1) 25%,transparent);--g2:color-mix(in srgb,var(--a2) 18%,transparent);--hv:1.4;--ov:rgba(0,0,0,.5)}
body{background:var(--bg)}
body::before{content:'';position:fixed;inset:0;z-index:-1;pointer-events:none;background:var(--web),radial-gradient(900px 520px at 12% 8%,var(--g1),transparent 70%),radial-gradient(800px 520px at 92% 85%,var(--g2),transparent 70%)}   /* fixed layer instead of background-attachment:fixed: far cheaper to scroll */
/* ===== v6 fixes + top bar + profile ===== */
.top{position:relative;z-index:30}.menu{z-index:40}.logo{display:flex;align-items:center;gap:10px}.logo svg{flex:none}
.iconbtn{width:40px;height:40px;border-radius:12px;display:grid;place-items:center;color:var(--mu);transition:.2s}.iconbtn:hover,.iconbtn.on{background:var(--panel2);color:var(--a1)}.iconbtn:hover svg{transform:rotate(60deg)}.iconbtn svg{transition:transform .35s}
.alogo{display:flex;justify-content:center;margin-bottom:14px}
#tbw{margin-top:12px;display:grid;gap:8px}#tbw textarea{margin:0}#tbw .btn{margin:0}
.pfrow{display:flex;align-items:center;gap:16px;margin-bottom:14px}.pfp{width:68px;height:68px;border-radius:50%;background:linear-gradient(135deg,var(--a1),var(--a2)) center/cover;display:grid;place-items:center;font-size:28px;font-weight:700;color:#fff;flex:none}
.ro{padding:12px 14px;border-radius:12px;background:var(--panel2);border:1px solid var(--bd);color:var(--mu);margin-top:4px}.cx{margin-left:6px;opacity:.5}.cx:hover{opacity:1;color:var(--dg)}
.cgrid{display:grid;grid-template-columns:repeat(5,1fr);gap:8px;margin:12px 0;font-size:12px;color:var(--mu)}.cgrid label{display:grid;gap:4px;text-align:center}.cgrid input{padding:0;height:38px;margin:0;cursor:pointer}
.cprev{background:var(--bg);padding:12px;border-radius:12px}.cprev div{background:var(--panel);color:var(--tx);padding:12px;border-radius:10px}.cprev b{color:var(--a1);display:block;margin-bottom:8px}.cprev .btn{background:linear-gradient(135deg,var(--a1),var(--a2));margin:8px 0 0}
